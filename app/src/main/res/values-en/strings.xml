    <!-- Privacy Policy full text -->
    <string name="policy_version_label">Version: %1$s</string>
    <string name="policy_effective_label">Effective date: %1$s</string>
    <string name="policy_updated_label">Last updated: %1$s</string>
    <string name="policy_sec_overview">1. Overview</string>
    <string name="policy_overview_umeng">This Privacy Policy is issued by %1$s (\"Developer\") for the MeaPet application. This build integrates the Umeng+ Analytics SDK to collect anonymized usage data for quality improvements.</string>
    <string name="policy_overview_nosdk">This Privacy Policy is issued by %1$s (\"Developer\") for the MeaPet application. This build contains no analytics SDK and collects no usage data.</string>
    <string name="policy_sec_collected">2. Data Collected</string>
    <string name="policy_collected_1">Device identifiers (OAID, Android ID, device model, OS version) for anonymized device distinction</string>
    <string name="policy_collected_2">Network info (Wi-Fi/cellular, IP address) for transmitting analytics requests</string>
    <string name="policy_collected_3">App usage info (launches, duration, app version, distribution channel)</string>
    <string name="policy_collected_4">SDK runtime metrics for stability and anti-fraud diagnostics</string>
    <string name="policy_sec_purpose">3. Purpose</string>
    <string name="policy_purpose_1">Generate anonymized device identifiers for analytics</string>
    <string name="policy_purpose_2">Measure active users, launches, and usage duration</string>
    <string name="policy_purpose_3">Identify and fix crashes and performance issues</string>
    <string name="policy_sec_sdk">4. Third-Party SDK</string>
    <string name="policy_sdk_name">SDK Name: Umeng+ Analytics SDK</string>
    <string name="policy_sdk_type">Service Type: Application analytics</string>
    <string name="policy_sdk_data">Personal info types: Device identifiers, network info, usage metrics, runtime logs</string>
    <string name="policy_sdk_link">Privacy policy link:</string>
    <string name="policy_sec_consent">5. Consent Management</string>
    <string name="policy_consent_1">On first launch, you may agree or decline analytics collection</string>
    <string name="policy_consent_2">If declined, the app functions normally and the analytics SDK is never initialized</string>
    <string name="policy_consent_3">Pre-initialization does not collect or transmit any data; full activation only happens after consent</string>
    <string name="policy_consent_4">You can revoke consent anytime in Settings, after which the app exits to halt reporting immediately</string>
    <string name="policy_sec_security">6. Data Security</string>
    <string name="policy_security_body">Data collected by Umeng+ SDK is anonymized and transmitted over encrypted channels strictly for statistical analysis.</string>
