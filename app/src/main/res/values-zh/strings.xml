    <!-- 隐私政策正文 -->
    <string name="policy_version_label">版本：%1$s</string>
    <string name="policy_effective_label">生效时间：%1$s</string>
    <string name="policy_updated_label">修订时间：%1$s</string>
    <string name="policy_sec_overview">一、概述</string>
    <string name="policy_overview_umeng">本隐私政策由 %1$s（下称「开发者」）制定并生效，适用于 MeaPet（梅尔桌宠）应用。本应用集成了友盟+（Umeng）统计 SDK，用于收集去标识化的使用数据以帮助改进产品质量。</string>
    <string name="policy_overview_nosdk">本隐私政策由 %1$s（下称「开发者」）制定并生效，适用于 MeaPet（梅尔桌宠）应用。本构建未包含任何统计 SDK，应用不采集任何使用数据。</string>
    <string name="policy_sec_collected">二、采集的信息</string>
    <string name="policy_collected_1">设备标识符：包括 OAID、Android ID、设备型号、操作系统版本等设备信息，用于生成脱敏标识</string>
    <string name="policy_collected_2">网络信息：网络类型（WiFi/移动网络）、IP 地址</string>
    <string name="policy_collected_3">应用使用信息：启动次数、使用时长、版本号、渠道来源</string>
    <string name="policy_collected_4">统计基础库运行信息：用于统计 SDK 的稳定性监控与风控分析</string>
    <string name="policy_sec_purpose">三、信息用途</string>
    <string name="policy_purpose_1">生成脱敏的终端用户设备唯一性标识以提供统计服务</string>
    <string name="policy_purpose_2">统计活跃用户数、启动次数与使用时长</string>
    <string name="policy_purpose_3">发现并修复应用崩溃与性能问题</string>
    <string name="policy_sec_sdk">四、第三方 SDK 信息</string>
    <string name="policy_sdk_name">SDK 名称：友盟+ 统计 SDK</string>
    <string name="policy_sdk_type">服务类型：应用统计分析</string>
    <string name="policy_sdk_data">收集个人信息类型：设备标识符、网络信息、应用使用信息与基础库运行信息</string>
    <string name="policy_sdk_link">隐私权政策链接：</string>
    <string name="policy_sec_consent">五、授权管理</string>
    <string name="policy_consent_1">首次启动时，你可以在弹窗中选择同意或不同意数据采集</string>
